# Modèle pour le poste de développement : copier en `.env` (jamais commité) et remplir.
# En prod et en CI, ces variables viennent de la plateforme, pas d'un fichier.

# --- Django ---
# Clé de signature (sessions, jetons). Obligatoire : sans elle, Django refuse de démarrer.
# Générer : uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=a-generer
# True ici pour le confort du dev. Le code vaut False par défaut, et prod.py le force à False.
DJANGO_DEBUG=True
# Noms d'hôte acceptés, séparés par des virgules. Vide = toute requête refusée hors debug.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données ---
# URL PostgreSQL au format postgres://utilisateur:motdepasse@hôte:port/nom_de_la_base
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# --- Redis (broker Celery, à partir de M3) ---
REDIS_URL=redis://localhost:6379/0
